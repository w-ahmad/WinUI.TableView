<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:WinUI.TableView">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="ms-appx:///WinUI.TableView/Themes/Resources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="DefaultTableViewRowPresenterStyle"
           TargetType="local:TableViewRowPresenter">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:TableViewRowPresenter">
                    <Grid x:Name="RootGrid"
                          Background="{TemplateBinding Background}"
                          BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}">

                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="DetailsStates">
                                <VisualState x:Name="DetailsVisible">
                                    <VisualState.Storyboard>
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsPanel"
                                                                           Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0"
                                                                        Value="Visible" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState.Storyboard>
                                </VisualState>
                                <VisualState x:Name="DetailsCollapsed">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Storyboard.TargetName="DetailsPanel"
                                                                       Storyboard.TargetProperty="Visibility">
                                            <DiscreteObjectKeyFrame KeyTime="0"
                                                                    Value="Collapsed" />
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="DetailsButtonStates">
                                <VisualState x:Name="DetailsButtonVisible">
                                    <VisualState.Setters>
                                        <Setter Target="DetailsToggleButton.Visibility"
                                                Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="DetailsButtonCollapsed">
                                    <VisualState.Setters>
                                        <Setter Target="DetailsToggleButton.Visibility"
                                                Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="RootPanel"
                              Margin="{TemplateBinding Padding}">

                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="HeaderColumn" Width="Auto" />
                                <ColumnDefinition x:Name="VerticalGridLineColumn" Width="Auto" />
                                <ColumnDefinition x:Name="FrozenCellsPanelColumn" Width="Auto" />
                                <ColumnDefinition x:Name="ScrollableCellsPanelColumn" Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="RowNumberColumn" Width="Auto" />
                                    <ColumnDefinition x:Name="RowHeaderColumn" Width="Auto" />
                                    <ColumnDefinition x:Name="DetailsExpandChevronColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock x:Name="RowNumberText"
                                           Grid.Column="0"
                                           Visibility="Collapsed"
                                           TextAlignment="Right"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="Center"
                                           MinWidth="{ThemeResource TableViewRowNumberMinWidth}"
                                           Margin="{ThemeResource TableViewRowNumberMargin}"
                                           FontSize="{ThemeResource TableViewRowNumberFontSize}"
                                           Foreground="{ThemeResource TableViewRowNumberForeground}"
                                           AutomationProperties.AccessibilityView="Raw" />

                                <local:TableViewRowHeader x:Name="RowHeader"
                                                           Grid.Column="1" />

                                <ToggleButton x:Name="DetailsToggleButton"
                                              Grid.Column="2"
                                              VerticalAlignment="Stretch"
                                              Visibility="Collapsed"
                                              Margin="{ThemeResource TableViewDetailsToggleButtonMargin}"
                                              Style="{StaticResource DetailsExpanderToggleButtonStyle}" />
                            </Grid>

                            <Border x:Name="IndentPlaceholder"
                                    Grid.Column="1"
                                    IsHitTestVisible="False" />

                            <Rectangle x:Name="VerticalGridLine"
                                       Width="1"
                                       Grid.RowSpan="2"
                                       Grid.Column="1"
                                       HorizontalAlignment="Right"
                                       VerticalAlignment="Stretch"
                                       IsHitTestVisible="False" />

                            <StackPanel x:Name="FrozenCellsPanel"
                                        Grid.Column="2"
                                        Orientation="Horizontal" />

                            <local:TableViewCellsPanel x:Name="ScrollableCellsPanel"
                                                       Grid.Column="3">
                                <!--This is just dummy textblock. It would be removed at runtime-->
                                <TextBlock Margin="16,0"
                                           Text="{Binding}"
                                           VerticalAlignment="Center" />
                            </local:TableViewCellsPanel>

                            <Grid x:Name="DetailsPanel"
                                  Grid.Row="1"
                                  Grid.Column="2"
                                  Grid.ColumnSpan="2"
                                  Visibility="Collapsed"
                                  Background="{ThemeResource TableViewRowDetailsBackgroundBrush}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <Rectangle x:Name="DetailsGridLine"
                                           HorizontalAlignment="Stretch"
                                           IsHitTestVisible="False" />

                                <ContentPresenter x:Name="DetailsPresenter"
                                                  Grid.Row="1"
                                                  Padding="{ThemeResource TableViewDetailsPadding}" />
                            </Grid>
                        </Grid>

                        <!--  The grid line is the bottom edge of a border as tall as the row, with the space below the content
                              kept for it. Far down a very long table, positions are kept to whole even pixels or coarser, and an
                              element only a pixel tall ends up with no height at all and is not drawn.  -->
                        <Border x:Name="HorizontalGridLineSpace"
                                Grid.Row="1"
                                IsHitTestVisible="False" />

                        <Border x:Name="HorizontalGridLine"
                                Grid.RowSpan="2"
                                IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>