<?xml version="1.0" encoding="utf-8" ?>
<Window x:Class="WinUI.TableView.SampleApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:local="using:WinUI.TableView.SampleApp"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="WinUI.TableView.SampleApp"
        xmlns:win="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:not_win="http://uno.ui/not_win"
        mc:Ignorable="d not_win">
    <win:Window.SystemBackdrop>
        <MicaBackdrop />
    </win:Window.SystemBackdrop>

    <Grid Loaded="RootGridLoaded" 
          not_win:Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">
        <win:Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </win:Grid.RowDefinitions>

        <win:TitleBar x:Name="AppTitleBar"
                  Title="WinUI.TableView"
                  Subtitle="Gallery"
                  BackRequested="OnBackRequested"
                  IsBackButtonVisible="{x:Bind rootFrame.CanGoBack, Mode=OneWay}"
                  IsPaneToggleButtonVisible="True"
                  PaneToggleRequested="TitleBar_PaneToggleRequested">
            <win:TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/TableView.ico" />
            </win:TitleBar.IconSource>
        </win:TitleBar>

        <NavigationView x:Name="navigationView"
                        Grid.Row="1"
                        IsBackButtonVisible="Collapsed"
                        win:IsPaneToggleButtonVisible="False"
                        not_win:PaneDisplayMode="Auto"
                        SelectionChanged="OnNavigationSelectionChanged"
                        IsEnabled="{Binding Visibility, ElementName=loadingIndicator, Converter={StaticResource VisibilityToBool}}">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox x:Name="searchBox"
                                PlaceholderText="Search samples"
                                QueryIcon="Find"
                                UpdateTextOnSelect="False"
                                TextChanged="OnSearchTextChanged"
                                QuerySubmitted="OnSearchQuerySubmitted">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="local:SampleInfo">
                            <Grid ColumnSpacing="12"
                                  Padding="0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="{x:Bind Glyph}"
                                          FontSize="16" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" />
                                    <TextBlock Text="{x:Bind Group.Title}"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>
            <NavigationView.Content>
                <Grid>
                    <Frame x:Name="rootFrame"
                           CacheSize="0"
                           IsNavigationStackEnabled="True"
                           Navigated="OnRootFrameNavigated"
                           IsEnabled="{Binding Visibility, ElementName=loadingIndicator, Converter={StaticResource VisibilityToBool}}" />
                    <StackPanel x:Name="loadingIndicator"
                                Spacing="16"
                                VerticalAlignment="Center"
                                HorizontalAlignment="Center">
                        <ProgressRing IsActive="True"
                                      Width="50"
                                      Height="50" />
                        <TextBlock Text="Preparing demo data..."
                                   Style="{StaticResource SubtitleTextBlockStyle}" />
                    </StackPanel>
                </Grid>
            </NavigationView.Content>
        </NavigationView>
    </Grid>
</Window>
