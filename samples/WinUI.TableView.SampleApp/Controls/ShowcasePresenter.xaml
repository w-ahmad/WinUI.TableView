<UserControl x:Class="WinUI.TableView.SampleApp.Controls.ShowcasePresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">

    <Grid Padding="24,16,24,20"
          RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="{x:Bind Header, Mode=OneWay}"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind Description, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Spacing="8"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <SelectorBar x:Name="viewSelector"
                             SelectionChanged="OnViewSelectionChanged">
                    <SelectorBarItem Text="Preview"
                                     IsSelected="True">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE7B3;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <Button ToolTipService.ToolTip="Toggle theme"
                        AutomationProperties.Name="Toggle theme"
                        Click="OnToggleThemeClicked">
                    <FontIcon Glyph="&#xE793;"
                              FontSize="16" />
                </Button>

                <DropDownButton ToolTipService.ToolTip="View source on GitHub"
                                AutomationProperties.Name="Source on GitHub">
                    <PathIcon Data="{StaticResource GitHubIcon}" />
                    <DropDownButton.Flyout>
                        <Flyout>
                            <StackPanel x:Name="sourceLinks"
                                        MinWidth="180" />
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
        </Grid>

        <Border x:Name="exampleContainer"
                Grid.Row="1"
                CornerRadius="8">
            <Grid>
                <Border x:Name="themeBackground"
                        Visibility="Collapsed"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <ContentControl Content="{x:Bind Example, Mode=OneWay}"
                                IsTabStop="False"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" />
            </Grid>
        </Border>

        <Border x:Name="codeContainer"
                Grid.Row="1"
                Visibility="Collapsed"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer x:Name="codeScroller"
                          Padding="20,16"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>
