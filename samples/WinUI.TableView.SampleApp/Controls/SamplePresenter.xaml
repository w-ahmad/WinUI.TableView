<UserControl x:Class="WinUI.TableView.SampleApp.Controls.SamplePresenter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             SizeChanged="OnSizeChanged">

    <Grid x:Name="root"
          Padding="24,16,24,20"
          RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"
                           MinHeight="300" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid Grid.ColumnSpan="2"
              ColumnSpacing="16"
              RowSpacing="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Spacing="2">
                <TextBlock x:Name="headerText"
                           Text="{x:Bind Header, Mode=OneWay}"
                           TextWrapping="Wrap"
                           Style="{StaticResource TitleTextBlockStyle}" />
                <TextBlock x:Name="descriptionText"
                           Text="{x:Bind Description, Mode=OneWay}"
                           TextWrapping="Wrap"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>

            <!--  Scrolls sideways when the window is too narrow for every tab  -->
            <ScrollViewer x:Name="toolbar"
                          Grid.Column="1"
                          VerticalAlignment="Top"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollMode="Disabled"
                          VerticalScrollBarVisibility="Disabled">
            <StackPanel Spacing="8"
                        Orientation="Horizontal">
                <!--  Preview, then one item per source: added when the control loads  -->
                <SelectorBar x:Name="viewSelector"
                             SelectionChanged="OnViewSelectionChanged">
                    <SelectorBarItem Text="Preview"
                                     IsSelected="True">
                        <SelectorBarItem.Icon>
                            <FontIcon Glyph="&#xE7B3;" />
                        </SelectorBarItem.Icon>
                    </SelectorBarItem>
                </SelectorBar>

                <Button ToolTipService.ToolTip="Toggle theme"
                        AutomationProperties.Name="Toggle theme"
                        VerticalAlignment="Center"
                        Click="OnToggleThemeClicked">
                    <FontIcon Glyph="&#xE793;"
                              FontSize="16" />
                </Button>

                <DropDownButton ToolTipService.ToolTip="View source on GitHub"
                                AutomationProperties.Name="Source on GitHub"
                                VerticalAlignment="Center">
                    <PathIcon Data="{StaticResource GitHubIcon}" />
                    <DropDownButton.Flyout>
                        <Flyout>
                            <StackPanel x:Name="sourceLinks"
                                        MinWidth="180" />
                        </Flyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </StackPanel>
            </ScrollViewer>
        </Grid>

        <Border x:Name="exampleContainer"
                Grid.Row="1"
                CornerRadius="8">
            <Grid>
                <Border x:Name="themeBackground"
                        Visibility="Collapsed"
                        Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
                <ContentControl Content="{x:Bind Example, Mode=OneWay}"
                                IsTabStop="False"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" />
            </Grid>
        </Border>

        <Border x:Name="optionsContainer"
                Grid.Row="1"
                Grid.Column="1"
                Margin="12,0,0,0"
                Padding="20,16"
                CornerRadius="8"
                BorderThickness="1"
                Visibility="{x:Bind Options, Mode=OneWay, Converter={StaticResource NullToVisibility}}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer>
                <ContentControl Content="{x:Bind Options, Mode=OneWay}"
                                IsTabStop="False"
                                VerticalContentAlignment="Stretch"
                                HorizontalContentAlignment="Stretch" />
            </ScrollViewer>
        </Border>

        <Border x:Name="codeContainer"
                Grid.Row="1"
                Grid.ColumnSpan="2"
                Visibility="Collapsed"
                CornerRadius="8"
                BorderThickness="1"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
            <ScrollViewer x:Name="codeScroller"
                          Padding="20,16"
                          HorizontalScrollMode="Auto"
                          HorizontalScrollBarVisibility="Auto" />
        </Border>
    </Grid>
</UserControl>
