<Page x:Class="WinUI.TableView.SampleApp.Pages.ReorderColumnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:WinUI.TableView.SampleApp"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:helpers="using:WinUI.TableView.SampleApp.Helpers"
      d:DataContext="{d:DesignInstance Type=local:ExampleViewModel}"
      mc:Ignorable="d"
      DataContextChanged="OnDataContextChanged">

    <Grid>
        <controls:SamplePresenter Header="Column Reorder"
                                  Description="Drag a column header to move the column. Drop it on another header to reorder, or back on its own slot to leave it where it was. Resizing a column afterwards keeps its cells aligned with the header.">
            <controls:SamplePresenter.Example>
                <tv:TableView x:Name="tableView"
                              ItemsSource="{Binding Items}"
                              GridLinesVisibility="All"
                              HeaderGridLinesVisibility="All"
                              CanReorderColumns="{x:Bind canReorderColumns.IsOn, Mode=OneWay}"
                              CanResizeColumns="{x:Bind canResizeColumns.IsOn, Mode=OneWay}"
                              ColumnReordering="OnColumnReordering"
                              ColumnReordered="OnColumnReordered"
                              AutoGeneratingColumn="{x:Bind local:ExampleModelColumnsHelper.OnAutoGeneratingColumns}" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            MinWidth="200">
                    <ToggleSwitch x:Name="canReorderColumns"
                                  Header="Can Reorder Columns"
                                  IsOn="True" />
                    <ToggleSwitch x:Name="canResizeColumns"
                                  Header="Can Resize Columns"
                                  IsOn="True" />
                    <ComboBox x:Name="columnResizeMode"
                              HorizontalAlignment="Stretch"
                              Header="Column Resize Mode"
                              SelectedItem="{Binding ColumnResizeMode, Mode=TwoWay, ElementName=tableView}"
                              ItemsSource="{helpers:EnumValues Type=tv:TableViewColumnResizeMode}" />
                    <TextBlock x:Name="lastReorder"
                               Text="No column moved yet."
                               TextWrapping="Wrap"
                               MaxWidth="200" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;tv:TableView ItemsSource="{Binding Items}"
    CanReorderColumns="$(CanReorderColumns)"
    CanResizeColumns="$(CanResizeColumns)"
    ColumnResizeMode="$(ColumnResizeMode)"
    ColumnReordering="OnColumnReordering"
    ColumnReordered="OnColumnReordered" /&gt;
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="CanReorderColumns"
                                           Value="{x:Bind canReorderColumns.IsOn, Mode=OneWay}" />
                <controls:CodeSubstitution Key="CanResizeColumns"
                                           Value="{x:Bind canResizeColumns.IsOn, Mode=OneWay}" />
                <controls:CodeSubstitution Key="ColumnResizeMode"
                                           Value="{x:Bind columnResizeMode.SelectedItem, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>
