<Page x:Class="WinUI.TableView.SampleApp.Pages.HeadersVisibilityPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.TableView.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      xmlns:ui="using:CommunityToolkit.WinUI"
      d:DataContext="{d:DesignInstance Type=local:ExampleViewModel}"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter Header="Headers Visibility"
                                  Description="Showcasing HeadersVisibility to show or hide row and column headers. Row headers are always frozen, so they stay in place while scrolling through many columns.">
            <controls:SamplePresenter.Example>
                <tv:TableView x:Name="tableView"
                              ItemsSource="{Binding Items}"
                              AutoGeneratingColumn="{x:Bind local:ExampleModelColumnsHelper.OnAutoGeneratingColumns}">
                    <tv:TableView.RowHeaderTemplate>
                        <DataTemplate x:DataType="local:ExampleModel">
                            <Border MinWidth="40">
                                <TextBlock Text="{x:Bind Id}"
                                           Opacity="0.6"
                                           FontSize="12"
                                           HorizontalAlignment="Center" />
                            </Border>
                        </DataTemplate>
                    </tv:TableView.RowHeaderTemplate>
                </tv:TableView>
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            MinWidth="200">
                    <ComboBox x:Name="headersVisibility"
                              Header="Headers Visibility"
                              HorizontalAlignment="Stretch"
                              SelectedItem="{Binding HeadersVisibility, Mode=TwoWay, ElementName=tableView}"
                              ItemsSource="{ui:EnumValues Type=tv:TableViewHeadersVisibility}" />
                    <TextBlock Text="Scroll the table horizontally to see the row headers stay frozen while column headers and cells scroll."
                               TextWrapping="Wrap"
                               Opacity="0.7" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;tv:TableView ItemsSource="{Binding Items}"
    HeadersVisibility="$(HeadersVisibility)" /&gt;
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="HeadersVisibility"
                                           Value="{x:Bind tableView.HeadersVisibility, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>
