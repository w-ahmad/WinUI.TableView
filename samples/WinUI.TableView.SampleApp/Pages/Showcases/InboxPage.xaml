<Page x:Class="WinUI.TableView.SampleApp.Pages.InboxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tv="using:WinUI.TableView"
      xmlns:data="using:WinUI.TableView.SampleApp.Showcases"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls">

    <Page.Resources>
        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="QuietHeaderStyle"
               TargetType="tv:TableViewColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="QuietRightHeaderStyle"
               TargetType="tv:TableViewColumnHeader"
               BasedOn="{StaticResource QuietHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!--  Row header: a dot on unread messages  -->
        <DataTemplate x:Key="UnreadHeaderTemplate"
                      x:DataType="data:MailMessage">
            <Ellipse Width="8"
                     Height="8"
                     HorizontalAlignment="Center"
                     Fill="{ThemeResource AccentFillColorDefaultBrush}"
                     Visibility="{x:Bind data:MailVisuals.UnreadVisibility(IsRead), Mode=OneWay}" />
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter Header="Inbox"
                                Description="TableView as a mail list. Unread rows are bold, flags toggle in place, and the selected row fills the reading pane."
                                Sources="MailMessage.cs">
        <controls:SamplePresenter.Example>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="readingColumn"
                                      Width="340" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Toolbar  -->
                        <Grid Padding="16,8"
                              ColumnSpacing="8"
                              BorderThickness="0,0,0,1"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <SelectorBar x:Name="viewFilter"
                                         SelectionChanged="OnViewFilterChanged">
                                <SelectorBarItem Text="All"
                                                 IsSelected="True" />
                                <SelectorBarItem x:Name="unreadFilter"
                                                 Text="Unread" />
                                <SelectorBarItem Text="Flagged" />
                            </SelectorBar>

                            <Button Grid.Column="2"
                                    Click="OnMarkAllReadClicked">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE8C3;"
                                              FontSize="14" />
                                    <TextBlock Text="Mark all read" />
                                </StackPanel>
                            </Button>
                            <AutoSuggestBox Grid.Column="3"
                                            Width="220"
                                            QueryIcon="Find"
                                            VerticalAlignment="Center"
                                            PlaceholderText="Search mail"
                                            TextChanged="OnSearchTextChanged" />
                        </Grid>

                        <tv:TableView x:Name="tableView"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind Messages}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="46"
                                      HeaderRowHeight="32"
                                      HeadersVisibility="All"
                                      CornerButtonMode="None"
                                      SelectionMode="Single"
                                      SelectionUnit="Row"
                                      CanFilterColumns="False"
                                      GridLinesVisibility="Horizontal"
                                      HeaderGridLinesVisibility="Horizontal"
                                      RowHeaderWidth="28"
                                      RowHeaderTemplate="{StaticResource UnreadHeaderTemplate}"
                                      ColumnHeaderStyle="{StaticResource QuietHeaderStyle}"
                                      SelectionChanged="OnSelectionChanged">
                            <tv:TableView.Resources>
                                <SolidColorBrush x:Key="TableViewHeaderRowBackground" Color="Transparent" />
                            </tv:TableView.Resources>

                            <tv:TableView.Columns>
                                <tv:TableViewTemplateColumn Header="From"
                                                            Width="190"
                                                            CanSort="True"
                                                            SortMemberPath="Sender">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:MailMessage">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10"
                                                        Margin="4,0,12,0">
                                                <Border Width="28"
                                                        Height="28"
                                                        CornerRadius="14"
                                                        Background="{x:Bind data:MailVisuals.AvatarBrush(Sender)}">
                                                    <TextBlock Text="{x:Bind data:Format.Initials(Sender)}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Sender}"
                                                           VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis"
                                                           FontWeight="{x:Bind data:MailVisuals.Weight(IsRead), Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <!--  Subject and preview share one cell, as mail clients show them  -->
                                <tv:TableViewTemplateColumn Header="Subject"
                                                            Width="*"
                                                            MinWidth="200"
                                                            CanSort="True"
                                                            SortMemberPath="Subject">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:MailMessage">
                                            <TextBlock Margin="12,0"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis">
                                                <Run Text="{x:Bind Subject}"
                                                     FontWeight="{x:Bind data:MailVisuals.Weight(IsRead), Mode=OneWay}" />
                                                <Run Text="  " />
                                                <Run Text="{x:Bind Preview}"
                                                     Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                                            </TextBlock>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="Category"
                                                            Width="104"
                                                            CanSort="True"
                                                            SortMemberPath="Category">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:MailMessage">
                                            <Border CornerRadius="4"
                                                    Padding="7,1,7,2"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Background="{x:Bind data:MailVisuals.CategoryTint(Category)}">
                                                <TextBlock Text="{x:Bind Category}"
                                                           FontSize="12" />
                                            </Border>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <!--  Icons and an in-place flag toggle; the header is an icon too  -->
                                <tv:TableViewTemplateColumn Width="76"
                                                            CanResize="False">
                                    <tv:TableViewTemplateColumn.Header>
                                        <FontIcon Glyph="&#xE7C1;"
                                                  FontSize="12" />
                                    </tv:TableViewTemplateColumn.Header>
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:MailMessage">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="2"
                                                        HorizontalAlignment="Right"
                                                        Margin="0,0,6,0">
                                                <FontIcon Glyph="&#xE723;"
                                                          FontSize="13"
                                                          Margin="0,0,4,0"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          Visibility="{x:Bind data:MailVisuals.AttachmentVisibility(Attachment)}" />
                                                <Button Width="30"
                                                        Height="30"
                                                        Padding="0"
                                                        BorderThickness="0"
                                                        Background="Transparent"
                                                        AutomationProperties.Name="Flag"
                                                        Tag="{x:Bind}"
                                                        Click="OnFlagClicked">
                                                    <FontIcon Glyph="&#xE7C1;"
                                                              FontSize="13"
                                                              Opacity="{x:Bind data:MailVisuals.FlagOpacity(IsFlagged), Mode=OneWay}"
                                                              Foreground="{x:Bind data:MailVisuals.FlagBrush(IsFlagged), Mode=OneWay}" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="Received"
                                                            Width="100"
                                                            CanSort="True"
                                                            SortMemberPath="Received"
                                                            HeaderStyle="{StaticResource QuietRightHeaderStyle}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:MailMessage">
                                            <TextBlock Text="{x:Bind data:MailVisuals.ShortTime(Received)}"
                                                       Margin="12,0"
                                                       FontSize="12"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </Grid>
                </Border>

                <!--  Reading pane, filled from the selected row  -->
                <Border x:Name="readingPane"
                        Grid.Column="1"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <StackPanel x:Name="emptyState"
                                    Spacing="8"
                                    VerticalAlignment="Center"
                                    HorizontalAlignment="Center">
                            <FontIcon Glyph="&#xE715;"
                                      FontSize="40"
                                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
                            <TextBlock Text="Select a message to read it"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>

                        <ScrollViewer x:Name="reader"
                                      Visibility="Collapsed">
                            <StackPanel Spacing="16"
                                        Padding="20">
                                <TextBlock Text="{x:Bind Selected.Subject, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           Style="{StaticResource SubtitleTextBlockStyle}" />

                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <PersonPicture Width="40"
                                                   Height="40"
                                                   DisplayName="{x:Bind Selected.Sender, Mode=OneWay}" />
                                    <StackPanel Grid.Column="1"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{x:Bind Selected.Sender, Mode=OneWay}"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{x:Bind Selected.SenderEmail, Mode=OneWay}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                </Grid>

                                <TextBlock x:Name="receivedText"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />

                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <Button Click="OnToggleFlagClicked">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8">
                                            <FontIcon Glyph="&#xE7C1;"
                                                      FontSize="14" />
                                            <TextBlock x:Name="flagText" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Mark unread"
                                            Click="OnMarkUnreadClicked" />
                                    <Button Content="Delete"
                                            Click="OnDeleteClicked" />
                                </StackPanel>

                                <Border Height="1"
                                        Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                <TextBlock Text="{x:Bind Selected.Body, Mode=OneWay}"
                                           TextWrapping="Wrap"
                                           IsTextSelectionEnabled="True" />

                                <Border x:Name="attachmentCard"
                                        Padding="12,10"
                                        CornerRadius="6"
                                        HorizontalAlignment="Left"
                                        BorderThickness="1"
                                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="10">
                                        <FontIcon Glyph="&#xE723;"
                                                  FontSize="16" />
                                        <TextBlock Text="{x:Bind Selected.Attachment, Mode=OneWay}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>
    </controls:SamplePresenter>
</Page>
