<Page x:Class="WinUI.TableView.SampleApp.Pages.IssueTrackerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tv="using:WinUI.TableView"
      xmlns:data="using:WinUI.TableView.SampleApp.Showcases"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls">

    <Page.Resources>
        <!--  Group header: a status dot, the group's name and its item count  -->
        <DataTemplate x:Key="GroupHeaderTemplate"
                      x:DataType="tv:TableViewGroupInfo">
            <StackPanel Orientation="Horizontal"
                        Spacing="10">
                <Ellipse Width="10"
                         Height="10"
                         Fill="{x:Bind data:WorkItemVisuals.GroupBrush(Key)}" />
                <TextBlock Text="{x:Bind data:WorkItemVisuals.GroupLabel(Key)}"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <Border CornerRadius="9"
                        Padding="8,1,8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{x:Bind Count}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!--  Group header container: taller, with a line under it instead of a fill  -->
        <Style x:Key="GroupHeaderContainerStyle"
               TargetType="tv:TableViewGroupHeaderRow">
            <Setter Property="MinHeight" Value="44" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
            <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        </Style>
    </Page.Resources>

    <controls:SamplePresenter Header="Issue Tracker"
                                Description="An editable backlog. Double-click a cell to edit it: change a status and the issue moves to its new group."
                                Sources="WorkItem.cs">
        <controls:SamplePresenter.Example>
            <Border CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Toolbar  -->
                    <ScrollViewer Style="{StaticResource HorizontalStripStyle}">
                    <Grid Padding="16,10"
                          ColumnSpacing="8"
                          BorderThickness="0,0,0,1"
                          BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Style="{StaticResource AccentButtonStyle}"
                                Click="OnNewIssueClicked">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <FontIcon Glyph="&#xE710;"
                                          FontSize="14" />
                                <TextBlock Text="New issue" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="deleteButton"
                                Grid.Column="1"
                                IsEnabled="False"
                                Click="OnDeleteClicked">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <FontIcon Glyph="&#xE74D;"
                                          FontSize="14" />
                                <TextBlock Text="Delete" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2"
                                Click="OnMarkDoneClicked">
                            <StackPanel Orientation="Horizontal"
                                        Spacing="8">
                                <FontIcon Glyph="&#xE73E;"
                                          FontSize="14" />
                                <TextBlock Text="Mark done" />
                            </StackPanel>
                        </Button>

                        <TextBlock x:Name="summary"
                                   Grid.Column="3"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <ComboBox x:Name="groupBy"
                                  Grid.Column="4"
                                  Width="170"
                                  SelectedIndex="0"
                                  SelectionChanged="OnGroupByChanged">
                            <x:String>Group by status</x:String>
                            <x:String>Group by assignee</x:String>
                            <x:String>Group by priority</x:String>
                            <x:String>No grouping</x:String>
                        </ComboBox>
                        <AutoSuggestBox Grid.Column="5"
                                        Width="220"
                                        QueryIcon="Find"
                                        PlaceholderText="Filter issues"
                                        TextChanged="OnSearchTextChanged" />
                    </Grid>
                    </ScrollViewer>

                    <tv:TableView x:Name="tableView"
                                  Grid.Row="1"
                                  ItemsSource="{x:Bind Items}"
                                  AutoGenerateColumns="False"
                                  AllowLiveShaping="True"
                                  DefaultGroupState="Expanded"
                                  RowHeight="44"
                                  HeadersVisibility="All"
                                  SelectionMode="Extended"
                                  SelectionUnit="Row"
                                  CornerButtonMode="None"
                                  GridLinesVisibility="Horizontal"
                                  HeaderGridLinesVisibility="Horizontal"
                                  RowDetailsVisibilityMode="VisibleWhenExpanded"
                                  SelectionChanged="OnSelectionChanged"
                                  CellEditEnded="OnCellEditEnded">
                        <tv:TableView.Resources>
                            <SolidColorBrush x:Key="TableViewHeaderRowBackground" Color="Transparent" />
                        </tv:TableView.Resources>

                        <tv:TableView.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}"
                                        HeaderContainerStyle="{StaticResource GroupHeaderContainerStyle}" />
                        </tv:TableView.GroupStyle>

                        <tv:TableView.RowDetailsTemplate>
                            <DataTemplate x:DataType="data:WorkItem">
                                <Grid ColumnSpacing="32"
                                      Padding="16,4,16,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"
                                                          MaxWidth="640" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Spacing="4">
                                        <TextBlock Text="Description"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Description}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1"
                                                Spacing="4">
                                        <TextBlock Text="Reported by"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind Reporter}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </tv:TableView.RowDetailsTemplate>

                        <tv:TableView.Columns>
                            <!--  Read-only template column  -->
                            <tv:TableViewTemplateColumn Header="Key"
                                                        Width="100"
                                                        IsReadOnly="True"
                                                        CanSort="True"
                                                        SortMemberPath="Key">
                                <tv:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="data:WorkItem">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    Margin="12,0">
                                            <FontIcon Glyph="{x:Bind data:WorkItemVisuals.TypeGlyph(Type)}"
                                                      FontSize="14"
                                                      ToolTipService.ToolTip="{x:Bind Type}"
                                                      Foreground="{x:Bind data:WorkItemVisuals.TypeBrush(Type)}" />
                                            <TextBlock Text="{x:Bind Key}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.CellTemplate>
                            </tv:TableViewTemplateColumn>

                            <!--  Built-in text editor  -->
                            <tv:TableViewTextColumn Header="Title"
                                                    Width="*"
                                                    MinWidth="200"
                                                    Binding="{Binding Title, Mode=TwoWay}" />

                            <tv:TableViewTemplateColumn Header="Labels"
                                                        Width="160"
                                                        IsReadOnly="True">
                                <tv:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="data:WorkItem">
                                        <ItemsRepeater ItemsSource="{x:Bind Labels}"
                                                       Margin="12,0"
                                                       VerticalAlignment="Center">
                                            <ItemsRepeater.Layout>
                                                <StackLayout Orientation="Horizontal"
                                                             Spacing="6" />
                                            </ItemsRepeater.Layout>
                                            <ItemsRepeater.ItemTemplate>
                                                <DataTemplate x:DataType="data:WorkItemLabel">
                                                    <Border CornerRadius="4"
                                                            Padding="7,1,7,2"
                                                            Background="{x:Bind data:WorkItemVisuals.LabelTint(Name)}">
                                                        <TextBlock Text="{x:Bind Name}"
                                                                   FontSize="12" />
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsRepeater.ItemTemplate>
                                        </ItemsRepeater>
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.CellTemplate>
                            </tv:TableViewTemplateColumn>

                            <!--  Template column with its own editor  -->
                            <tv:TableViewTemplateColumn Header="Priority"
                                                        Width="120"
                                                        CanSort="True"
                                                        SortMemberPath="Priority">
                                <tv:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="data:WorkItem">
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="8"
                                                    Margin="12,0">
                                            <FontIcon Glyph="{x:Bind data:WorkItemVisuals.PriorityGlyph(Priority), Mode=OneWay}"
                                                      FontSize="13"
                                                      Foreground="{x:Bind data:WorkItemVisuals.PriorityBrush(Priority), Mode=OneWay}" />
                                            <TextBlock Text="{x:Bind Priority, Mode=OneWay}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.CellTemplate>
                                <tv:TableViewTemplateColumn.EditingTemplate>
                                    <DataTemplate x:DataType="data:WorkItem">
                                        <ComboBox ItemsSource="{x:Bind data:WorkItemData.Priorities}"
                                                  SelectedItem="{x:Bind Priority, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.EditingTemplate>
                            </tv:TableViewTemplateColumn>

                            <tv:TableViewTemplateColumn Header="Assignee"
                                                        Width="160"
                                                        CanSort="True"
                                                        SortMemberPath="Assignee">
                                <tv:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="data:WorkItem">
                                        <Grid Margin="12,0">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="8"
                                                        Visibility="{x:Bind data:WorkItemVisuals.AssignedVisibility(Assignee), Mode=OneWay}">
                                                <Border Width="24"
                                                        Height="24"
                                                        CornerRadius="12"
                                                        Background="{x:Bind data:WorkItemVisuals.AvatarBrush(Assignee), Mode=OneWay}">
                                                    <TextBlock Text="{x:Bind data:Format.Initials(Assignee), Mode=OneWay}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Assignee, Mode=OneWay}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                            <TextBlock Text="Unassigned"
                                                       FontStyle="Italic"
                                                       VerticalAlignment="Center"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{x:Bind data:WorkItemVisuals.UnassignedVisibility(Assignee), Mode=OneWay}" />
                                        </Grid>
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.CellTemplate>
                                <tv:TableViewTemplateColumn.EditingTemplate>
                                    <DataTemplate x:DataType="data:WorkItem">
                                        <ComboBox ItemsSource="{x:Bind data:WorkItemData.Assignees}"
                                                  SelectedItem="{x:Bind Assignee, Mode=TwoWay}"
                                                  PlaceholderText="Unassigned"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.EditingTemplate>
                            </tv:TableViewTemplateColumn>

                            <tv:TableViewTemplateColumn Header="Status"
                                                        Width="130"
                                                        CanSort="True"
                                                        SortMemberPath="Status">
                                <tv:TableViewTemplateColumn.CellTemplate>
                                    <DataTemplate x:DataType="data:WorkItem">
                                        <Border CornerRadius="11"
                                                Padding="8,2,10,3"
                                                Margin="12,0"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Left"
                                                Background="{x:Bind data:WorkItemVisuals.StatusTint(Status), Mode=OneWay}">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6">
                                                <Ellipse Width="6"
                                                         Height="6"
                                                         Fill="{x:Bind data:WorkItemVisuals.StatusBrush(Status), Mode=OneWay}" />
                                                <TextBlock Text="{x:Bind Status, Mode=OneWay}"
                                                           FontSize="12" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.CellTemplate>
                                <tv:TableViewTemplateColumn.EditingTemplate>
                                    <DataTemplate x:DataType="data:WorkItem">
                                        <ComboBox ItemsSource="{x:Bind data:WorkItemData.Statuses}"
                                                  SelectedItem="{x:Bind Status, Mode=TwoWay}"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Stretch" />
                                    </DataTemplate>
                                </tv:TableViewTemplateColumn.EditingTemplate>
                            </tv:TableViewTemplateColumn>

                            <!--  Built-in number and date editors  -->
                            <tv:TableViewNumberColumn Header="Points"
                                                      Width="80"
                                                      Binding="{Binding Points, Mode=TwoWay}" />

                            <tv:TableViewDateColumn Header="Due"
                                                    Width="120"
                                                    Binding="{Binding Due, Mode=TwoWay}" />
                        </tv:TableView.Columns>
                    </tv:TableView>
                </Grid>
            </Border>
        </controls:SamplePresenter.Example>
    </controls:SamplePresenter>
</Page>
