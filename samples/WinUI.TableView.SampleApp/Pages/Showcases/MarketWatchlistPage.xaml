<Page x:Class="WinUI.TableView.SampleApp.Pages.MarketWatchlistPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tv="using:WinUI.TableView"
      xmlns:data="using:WinUI.TableView.SampleApp.Showcases"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      Unloaded="OnUnloaded">

    <Page.Resources>
        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <!--  Small, quiet, upper-case column headers  -->
        <Style x:Key="QuietHeaderStyle"
               TargetType="tv:TableViewColumnHeader">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="CharacterSpacing" Value="60" />
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>

        <Style x:Key="QuietRightHeaderStyle"
               TargetType="tv:TableViewColumnHeader"
               BasedOn="{StaticResource QuietHeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="NumberStyle"
               TargetType="TextBlock">
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        </Style>

        <!--  Row header: a favorite toggle  -->
        <DataTemplate x:Key="FavoriteHeaderTemplate"
                      x:DataType="data:Stock">
            <ToggleButton IsChecked="{x:Bind IsFavorite, Mode=TwoWay}"
                          Width="32"
                          Height="32"
                          Padding="0"
                          BorderThickness="0"
                          Background="Transparent"
                          HorizontalAlignment="Center"
                          AutomationProperties.Name="Favorite"
                          Click="OnFavoriteClicked">
                <ToggleButton.Resources>
                    <SolidColorBrush x:Key="ToggleButtonBackgroundChecked" Color="Transparent" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPointerOver" Color="{ThemeResource SubtleFillColorSecondary}" />
                    <SolidColorBrush x:Key="ToggleButtonBackgroundCheckedPressed" Color="{ThemeResource SubtleFillColorTertiary}" />
                </ToggleButton.Resources>
                <FontIcon Glyph="{x:Bind data:StockVisuals.StarGlyph(IsFavorite), Mode=OneWay}"
                          FontSize="14"
                          Foreground="{x:Bind data:StockVisuals.StarBrush(IsFavorite), Mode=OneWay}" />
            </ToggleButton>
        </DataTemplate>

        <!--  Cell styles picked per row by the predicates in code-behind  -->
        <tv:TableViewConditionalCellStylesCollection x:Key="MoverCellStyles">
            <tv:TableViewConditionalCellStyle Predicate="{x:Bind IsSurging}">
                <Style TargetType="tv:TableViewCell">
                    <Setter Property="Background" Value="#261EAA5A" />
                </Style>
            </tv:TableViewConditionalCellStyle>
            <tv:TableViewConditionalCellStyle Predicate="{x:Bind IsPlunging}">
                <Style TargetType="tv:TableViewCell">
                    <Setter Property="Background" Value="#26E24848" />
                </Style>
            </tv:TableViewConditionalCellStyle>
        </tv:TableViewConditionalCellStylesCollection>
    </Page.Resources>

    <controls:SamplePresenter Header="Market Watchlist"
                                Description="Prices tick several times a second. Cells redraw through plain property change notifications; no rows are rebuilt."
                                Sources="Stock.cs">
        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Index cards  -->
                <ScrollViewer Style="{StaticResource HorizontalStripStyle}">
                <ItemsRepeater ItemsSource="{x:Bind Indices}"
                               MinWidth="996">
                    <ItemsRepeater.Layout>
                        <UniformGridLayout MinItemWidth="240"
                                           MinItemHeight="94"
                                           MinColumnSpacing="12"
                                           MinRowSpacing="12"
                                           MaximumRowsOrColumns="4"
                                           ItemsStretch="Fill" />
                    </ItemsRepeater.Layout>
                    <ItemsRepeater.ItemTemplate>
                        <DataTemplate x:DataType="data:Stock">
                            <Border Style="{StaticResource CardStyle}"
                                    Padding="16,12">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{x:Bind Company}"
                                                   Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                        <TextBlock Text="{x:Bind data:Format.Price(Price), Mode=OneWay}"
                                                   FontSize="22"
                                                   FontWeight="SemiBold" />
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="4">
                                            <FontIcon Glyph="{x:Bind data:StockVisuals.TrendGlyph(Change), Mode=OneWay}"
                                                      FontSize="8"
                                                      Foreground="{x:Bind data:StockVisuals.TrendBrush(Change), Mode=OneWay}" />
                                            <TextBlock FontSize="12"
                                                       Foreground="{x:Bind data:StockVisuals.TrendBrush(Change), Mode=OneWay}">
                                                <Run Text="{x:Bind data:StockVisuals.Signed(Change), Mode=OneWay}" />
                                                <Run Text="{x:Bind data:StockVisuals.SignedPercent(ChangePercent), Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                    <Polyline Grid.Column="1"
                                              Width="96"
                                              Height="26"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              VerticalAlignment="Center"
                                              Stroke="{x:Bind data:StockVisuals.TrendBrush(Change), Mode=OneWay}"
                                              Points="{x:Bind data:StockVisuals.Sparkline(History, Price), Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsRepeater.ItemTemplate>
                </ItemsRepeater>
                </ScrollViewer>

                <Border Grid.Row="1"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Toolbar  -->
                        <ScrollViewer Style="{StaticResource HorizontalStripStyle}">
                        <Grid Padding="16,10"
                              ColumnSpacing="12"
                              BorderThickness="0,0,0,1"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ToggleButton x:Name="favoritesOnly"
                                          Click="OnFavoritesOnlyClicked">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE735;"
                                              FontSize="14" />
                                    <TextBlock Text="Favorites" />
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton x:Name="groupBySector"
                                          Grid.Column="1"
                                          Click="OnGroupBySectorClicked">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xF168;"
                                              FontSize="14" />
                                    <TextBlock Text="Group by sector" />
                                </StackPanel>
                            </ToggleButton>
                            <Button Grid.Column="2"
                                    Click="OnSortByMoversClicked">
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE8CB;"
                                              FontSize="14" />
                                    <TextBlock Text="Top movers" />
                                </StackPanel>
                            </Button>

                            <StackPanel Grid.Column="3"
                                        Orientation="Horizontal"
                                        Spacing="8"
                                        HorizontalAlignment="Right">
                                <Ellipse x:Name="liveDot"
                                         Width="8"
                                         Height="8"
                                         Fill="#1EAA5A" />
                                <TextBlock x:Name="status"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ToggleSwitch x:Name="live"
                                          Grid.Column="4"
                                          MinWidth="0"
                                          IsOn="True"
                                          OnContent="Live"
                                          OffContent="Paused"
                                          Toggled="OnLiveToggled" />
                        </Grid>
                        </ScrollViewer>

                        <tv:TableView x:Name="tableView"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind Stocks}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="52"
                                      HeaderRowHeight="36"
                                      HeadersVisibility="All"
                                      CornerButtonMode="None"
                                      SelectionMode="Single"
                                      SelectionUnit="Row"
                                      DefaultGroupState="Expanded"
                                      GridLinesVisibility="Horizontal"
                                      HeaderGridLinesVisibility="Horizontal"
                                      RowHeaderWidth="44"
                                      RowHeaderTemplate="{StaticResource FavoriteHeaderTemplate}"
                                      ColumnHeaderStyle="{StaticResource QuietHeaderStyle}">
                            <tv:TableView.Resources>
                                <SolidColorBrush x:Key="TableViewHeaderRowBackground" Color="Transparent" />
                            </tv:TableView.Resources>

                            <tv:TableView.Columns>
                                <tv:TableViewTemplateColumn Header="SYMBOL"
                                                            Width="*"
                                                            MinWidth="170"
                                                            CanSort="True"
                                                            SortMemberPath="Symbol">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Stock">
                                            <StackPanel Margin="12,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind Symbol}"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{x:Bind Company}"
                                                           FontSize="12"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTextColumn Header="SECTOR"
                                                        Width="120"
                                                        Binding="{Binding Sector}" />

                                <tv:TableViewTemplateColumn Header="LAST"
                                                            Width="110"
                                                            CanSort="True"
                                                            SortMemberPath="Price"
                                                            HeaderStyle="{StaticResource QuietRightHeaderStyle}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Stock">
                                            <TextBlock Text="{x:Bind data:Format.Price(Price), Mode=OneWay}"
                                                       FontWeight="SemiBold"
                                                       Style="{StaticResource NumberStyle}" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="CHANGE"
                                                            Width="160"
                                                            CanSort="True"
                                                            SortMemberPath="ChangePercent"
                                                            HeaderStyle="{StaticResource QuietRightHeaderStyle}"
                                                            ConditionalCellStyles="{StaticResource MoverCellStyles}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Stock">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10"
                                                        Margin="12,0"
                                                        HorizontalAlignment="Right">
                                                <TextBlock Text="{x:Bind data:StockVisuals.Signed(Change), Mode=OneWay}"
                                                           Margin="0"
                                                           Style="{StaticResource NumberStyle}"
                                                           Foreground="{x:Bind data:StockVisuals.TrendBrush(Change), Mode=OneWay}" />
                                                <Border MinWidth="72"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center"
                                                        Background="{x:Bind data:StockVisuals.TrendTint(Change), Mode=OneWay}">
                                                    <StackPanel Orientation="Horizontal"
                                                                Spacing="4"
                                                                HorizontalAlignment="Right">
                                                        <FontIcon Glyph="{x:Bind data:StockVisuals.TrendGlyph(Change), Mode=OneWay}"
                                                                  FontSize="7"
                                                                  Foreground="{x:Bind data:StockVisuals.TrendBrush(Change), Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind data:StockVisuals.SignedPercent(ChangePercent), Mode=OneWay}"
                                                                   Margin="0"
                                                                   FontSize="12"
                                                                   Style="{StaticResource NumberStyle}"
                                                                   Foreground="{x:Bind data:StockVisuals.TrendBrush(Change), Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="TREND"
                                                            Width="124"
                                                            CanResize="False">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Stock">
                                            <Polyline Width="96"
                                                      Height="26"
                                                      StrokeThickness="1.5"
                                                      StrokeLineJoin="Round"
                                                      VerticalAlignment="Center"
                                                      HorizontalAlignment="Center"
                                                      Stroke="{x:Bind data:StockVisuals.TrendBrush(Change), Mode=OneWay}"
                                                      Points="{x:Bind data:StockVisuals.Sparkline(History, Price), Mode=OneWay}" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="DAY RANGE"
                                                            Width="212"
                                                            CanResize="False">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Stock">
                                            <Grid ColumnSpacing="8"
                                                  Margin="12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="72" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{x:Bind data:Format.Price(DayLow), Mode=OneWay}"
                                                           Margin="0"
                                                           FontSize="12"
                                                           Style="{StaticResource NumberStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Grid Grid.Column="1"
                                                      VerticalAlignment="Center">
                                                    <Border Height="4"
                                                            CornerRadius="2"
                                                            Background="{ThemeResource ControlStrongFillColorDisabledBrush}" />
                                                    <Ellipse Width="8"
                                                             Height="8"
                                                             HorizontalAlignment="Left"
                                                             Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                                             Margin="{x:Bind data:StockVisuals.RangeMarker(DayLow, DayHigh, Price), Mode=OneWay}" />
                                                </Grid>
                                                <TextBlock Grid.Column="2"
                                                           Text="{x:Bind data:Format.Price(DayHigh), Mode=OneWay}"
                                                           Margin="0"
                                                           FontSize="12"
                                                           HorizontalAlignment="Left"
                                                           Style="{StaticResource NumberStyle}"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="VOLUME"
                                                            Width="92"
                                                            CanSort="True"
                                                            SortMemberPath="Volume"
                                                            HeaderStyle="{StaticResource QuietRightHeaderStyle}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Stock">
                                            <TextBlock Text="{x:Bind data:Format.CompactNumber(Volume), Mode=OneWay}"
                                                       Style="{StaticResource NumberStyle}" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="MKT CAP"
                                                            Width="92"
                                                            CanSort="True"
                                                            SortMemberPath="MarketCap"
                                                            HeaderStyle="{StaticResource QuietRightHeaderStyle}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Stock">
                                            <TextBlock Text="{x:Bind data:Format.CompactMoney(MarketCap)}"
                                                       Style="{StaticResource NumberStyle}" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </Grid>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>
    </controls:SamplePresenter>
</Page>
