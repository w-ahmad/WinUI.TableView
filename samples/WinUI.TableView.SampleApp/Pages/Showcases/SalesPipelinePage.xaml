<Page x:Class="WinUI.TableView.SampleApp.Pages.SalesPipelinePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:tv="using:WinUI.TableView"
      xmlns:data="using:WinUI.TableView.SampleApp.Showcases"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls">

    <Page.Resources>
        <Style x:Key="CardStyle"
               TargetType="Border">
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        </Style>

        <Style x:Key="KpiIconStyle"
               TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>

        <Style x:Key="KpiValueStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource SubtitleTextBlockStyle}">
            <Setter Property="FontSize" Value="22" />
        </Style>

        <Style x:Key="KpiCaptionStyle"
               TargetType="TextBlock"
               BasedOn="{StaticResource CaptionTextBlockStyle}">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Right-aligns the header of a numeric column, to sit above its right-aligned cells  -->
        <Style x:Key="RightAlignedHeaderStyle"
               TargetType="tv:TableViewColumnHeader">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <!--  Row header: a strip in the color of the deal's stage  -->
        <DataTemplate x:Key="StageStripTemplate"
                      x:DataType="data:Deal">
            <Rectangle Width="4"
                       Height="22"
                       Margin="6,0,0,0"
                       RadiusX="2"
                       RadiusY="2"
                       HorizontalAlignment="Left"
                       Fill="{x:Bind data:DealVisuals.Accent(Stage), Mode=OneWay}" />
        </DataTemplate>

        <!--  Group header: what a group is called depends on the column grouped by  -->
        <DataTemplate x:Key="GroupHeaderTemplate"
                      x:DataType="tv:TableViewGroupInfo">
            <StackPanel Orientation="Horizontal"
                        Spacing="10">
                <Ellipse Width="10"
                         Height="10"
                         Fill="{x:Bind data:DealVisuals.GroupAccent(Key)}" />
                <TextBlock Text="{x:Bind data:DealVisuals.GroupLabel(Key)}"
                           FontSize="14"
                           FontWeight="SemiBold" />
                <Border CornerRadius="9"
                        Padding="8,1,8,2"
                        VerticalAlignment="Center"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                    <TextBlock Text="{x:Bind data:Format.Count(Count)}"
                               FontSize="12"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <controls:SamplePresenter Header="Sales Pipeline"
                                Description="A deal ledger for 5,000 opportunities. Every cell below is a TableView column: pills, avatars, bars and all."
                                Sources="Deal.cs">
        <controls:SamplePresenter.Example>
            <Grid RowSpacing="12">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  KPI cards, recalculated when the region changes  -->
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Style="{StaticResource CardStyle}"
                            Padding="16,14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconStyle}"
                                    Background="#280078D4">
                                <FontIcon Glyph="&#xE9D2;"
                                          FontSize="16"
                                          Foreground="#0078D4" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Total open pipeline"
                                           Style="{StaticResource KpiCaptionStyle}" />
                                <TextBlock x:Name="openPipelineValue"
                                           Style="{StaticResource KpiValueStyle}" />
                                <TextBlock x:Name="openPipelineCaption"
                                           Style="{StaticResource KpiCaptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="16,14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconStyle}"
                                    Background="#2810893E">
                                <FontIcon Glyph="&#xE73E;"
                                          FontSize="16"
                                          Foreground="#10893E" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Won this quarter"
                                           Style="{StaticResource KpiCaptionStyle}" />
                                <TextBlock x:Name="wonValue"
                                           Style="{StaticResource KpiValueStyle}" />
                                <TextBlock x:Name="wonCaption"
                                           Style="{StaticResource KpiCaptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="2"
                            Style="{StaticResource CardStyle}"
                            Padding="16,14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconStyle}"
                                    Background="#28DA8B00">
                                <FontIcon Glyph="&#xE8C7;"
                                          FontSize="16"
                                          Foreground="#DA8B00" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Average deal size"
                                           Style="{StaticResource KpiCaptionStyle}" />
                                <TextBlock x:Name="averageValue"
                                           Style="{StaticResource KpiValueStyle}" />
                                <TextBlock x:Name="averageCaption"
                                           Style="{StaticResource KpiCaptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Column="3"
                            Style="{StaticResource CardStyle}"
                            Padding="16,14">
                        <Grid ColumnSpacing="14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource KpiIconStyle}"
                                    Background="#288764B8">
                                <FontIcon Glyph="&#xE7C1;"
                                          FontSize="16"
                                          Foreground="#8764B8" />
                            </Border>
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Win rate"
                                           Style="{StaticResource KpiCaptionStyle}" />
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock x:Name="winRateValue"
                                               Style="{StaticResource KpiValueStyle}" />
                                    <ProgressBar x:Name="winRateBar"
                                                 Grid.Column="1"
                                                 VerticalAlignment="Center" />
                                </Grid>
                                <TextBlock x:Name="winRateCaption"
                                           Style="{StaticResource KpiCaptionStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1"
                        Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Toolbar  -->
                        <Grid Padding="16,12"
                              ColumnSpacing="12"
                              BorderThickness="0,0,0,1"
                              BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <AutoSuggestBox x:Name="searchBox"
                                            Width="280"
                                            VerticalAlignment="Center"
                                            QueryIcon="Find"
                                            PlaceholderText="Search deals, accounts, owners"
                                            TextChanged="OnSearchTextChanged" />
                            <ComboBox x:Name="regionFilter"
                                      Grid.Column="1"
                                      Width="200"
                                      VerticalAlignment="Center"
                                      ItemsSource="{x:Bind RegionOptions}"
                                      SelectedIndex="0"
                                      SelectionChanged="OnRegionChanged" />
                            <ComboBox x:Name="groupBy"
                                      Grid.Column="2"
                                      Width="180"
                                      VerticalAlignment="Center"
                                      SelectedIndex="0"
                                      SelectionChanged="OnGroupByChanged">
                                <x:String>No grouping</x:String>
                                <x:String>Group by stage</x:String>
                                <x:String>Group by region</x:String>
                                <x:String>Group by owner</x:String>
                            </ComboBox>
                            <TextBlock x:Name="dealCount"
                                       Grid.Column="3"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <SelectorBar Grid.Column="4"
                                         SelectionChanged="OnDensityChanged">
                                <SelectorBarItem Text="Compact"
                                                 Tag="32" />
                                <SelectorBarItem Text="Standard"
                                                 Tag="44"
                                                 IsSelected="True" />
                                <SelectorBarItem Text="Comfortable"
                                                 Tag="56" />
                            </SelectorBar>
                        </Grid>

                        <tv:TableView x:Name="tableView"
                                      Grid.Row="1"
                                      ItemsSource="{x:Bind Deals}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      RowHeight="44"
                                      HeaderRowHeight="40"
                                      SelectionMode="Extended"
                                      SelectionUnit="Row"
                                      HeadersVisibility="All"
                                      CornerButtonMode="None"
                                      GridLinesVisibility="Horizontal"
                                      HeaderGridLinesVisibility="Horizontal"
                                      RowHeaderWidth="16"
                                      RowHeaderTemplate="{StaticResource StageStripTemplate}"
                                      DefaultGroupState="Expanded"
                                      RowDetailsVisibilityMode="VisibleWhenSelected">
                            <tv:TableView.Resources>
                                <!--  Lightweight styling: the header row blends into the card  -->
                                <SolidColorBrush x:Key="TableViewHeaderRowBackground" Color="Transparent" />
                            </tv:TableView.Resources>

                            <tv:TableView.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                            </tv:TableView.GroupStyle>

                            <tv:TableView.RowDetailsTemplate>
                                <DataTemplate x:DataType="data:Deal">
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="20"
                                                Padding="16,2,16,10">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                            <Run Text="{x:Bind Id}"
                                                 FontWeight="SemiBold" />
                                            <Run Text="  ·  " />
                                            <Run Text="{x:Bind Category}" />
                                        </TextBlock>
                                        <StackPanel Orientation="Horizontal"
                                                    Spacing="6">
                                            <FontIcon Glyph="&#xE72A;"
                                                      FontSize="12"
                                                      Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                                            <TextBlock>
                                                <Run Text="Next:"
                                                     Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                                <Run Text="{x:Bind NextStep}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </tv:TableView.RowDetailsTemplate>

                            <tv:TableView.Columns>
                                <tv:TableViewTextColumn Header="Deal"
                                                        Width="2*"
                                                        MinWidth="160"
                                                        Binding="{Binding Name}" />

                                <tv:TableViewTemplateColumn Header="Account"
                                                            Width="1.6*"
                                                            MinWidth="160"
                                                            CanSort="True"
                                                            SortMemberPath="Account">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Deal">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="10"
                                                        Margin="12,0">
                                                <Border Width="24"
                                                        Height="24"
                                                        CornerRadius="12"
                                                        Background="{x:Bind data:Palette.Avatar(AccountSeed)}">
                                                    <TextBlock Text="{x:Bind data:Format.Initials(Account)}"
                                                               FontSize="9"
                                                               FontWeight="SemiBold"
                                                               Foreground="White"
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{x:Bind Account}"
                                                           VerticalAlignment="Center" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTextColumn Header="Owner"
                                                        Width="1.2*"
                                                        MinWidth="110"
                                                        Binding="{Binding Owner}" />

                                <tv:TableViewTextColumn Header="Region"
                                                        Width="1.3*"
                                                        MinWidth="120"
                                                        Binding="{Binding Region}" />

                                <tv:TableViewTemplateColumn Header="Stage"
                                                            Width="140"
                                                            CanSort="True"
                                                            SortMemberPath="Stage">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Deal">
                                            <Border CornerRadius="11"
                                                    Padding="8,2,10,3"
                                                    Margin="12,0"
                                                    VerticalAlignment="Center"
                                                    HorizontalAlignment="Left"
                                                    Background="{x:Bind data:DealVisuals.Tint(Stage), Mode=OneWay}">
                                                <StackPanel Orientation="Horizontal"
                                                            Spacing="6">
                                                    <Ellipse Width="6"
                                                             Height="6"
                                                             Fill="{x:Bind data:DealVisuals.Accent(Stage), Mode=OneWay}" />
                                                    <TextBlock Text="{x:Bind data:DealVisuals.Label(Stage), Mode=OneWay}"
                                                               FontSize="12" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="Amount"
                                                            Width="120"
                                                            CanSort="True"
                                                            SortMemberPath="Amount"
                                                            HeaderStyle="{StaticResource RightAlignedHeaderStyle}">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Deal">
                                            <TextBlock Text="{x:Bind data:Format.Currency(Amount)}"
                                                       Margin="12,0"
                                                       FontWeight="SemiBold"
                                                       VerticalAlignment="Center"
                                                       HorizontalAlignment="Right" />
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="Probability"
                                                            Width="150"
                                                            CanSort="True"
                                                            SortMemberPath="Probability">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Deal">
                                            <Grid ColumnSpacing="10"
                                                  Margin="12,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="36" />
                                                </Grid.ColumnDefinitions>
                                                <ProgressBar Value="{x:Bind Probability, Mode=OneWay}"
                                                             VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1"
                                                           Text="{x:Bind data:Format.Percent(Probability), Mode=OneWay}"
                                                           FontSize="12"
                                                           VerticalAlignment="Center"
                                                           HorizontalAlignment="Right"
                                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                            </Grid>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>

                                <tv:TableViewTemplateColumn Header="Close date"
                                                            Width="140"
                                                            CanSort="True"
                                                            SortMemberPath="CloseDate">
                                    <tv:TableViewTemplateColumn.CellTemplate>
                                        <DataTemplate x:DataType="data:Deal">
                                            <StackPanel Orientation="Horizontal"
                                                        Spacing="6"
                                                        Margin="12,0">
                                                <TextBlock Text="{x:Bind data:Format.Date(CloseDate)}"
                                                           VerticalAlignment="Center" />
                                                <FontIcon Glyph="&#xE7BA;"
                                                          FontSize="12"
                                                          ToolTipService.ToolTip="Past its close date"
                                                          Foreground="{ThemeResource SystemFillColorCautionBrush}"
                                                          Visibility="{x:Bind data:DealVisuals.OverdueVisibility(Stage, CloseDate), Mode=OneWay}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </tv:TableViewTemplateColumn.CellTemplate>
                                </tv:TableViewTemplateColumn>
                            </tv:TableView.Columns>
                        </tv:TableView>
                    </Grid>
                </Border>
            </Grid>
        </controls:SamplePresenter.Example>
    </controls:SamplePresenter>
</Page>
