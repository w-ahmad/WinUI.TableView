<Page x:Class="WinUI.TableView.SampleApp.Pages.OverviewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.TableView.SampleApp"
      xmlns:pages="using:WinUI.TableView.SampleApp.Pages"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      xmlns:helpers="using:WinUI.TableView.SampleApp.Helpers"
      d:DataContext="{d:DesignInstance Type=local:ExampleViewModel}"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter x:Name="presenter"
                                  Header="Overview"
                                  Description="TableView with nothing but an ItemsSource: columns are generated from the item type, and sorting, filtering, editing, selection and the clipboard all work out of the box.">
            <controls:SamplePresenter.Example>
                <tv:TableView ItemsSource="{Binding Items}" ShowRowNumbers="True" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            Width="260">
                    <TextBlock Text="Things to try"
                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8CB;"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Sort"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Click a column header. Ctrl+click another to sort by both."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE71C;"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Filter"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Open the options button in a column header and pick the values to keep."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE70F;"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Edit"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Double-click a cell or press F2. Enter commits, Escape cancels."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE762;"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Select"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Click a row header for a row, or drag across cells for a range."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE8C8;"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Copy and paste"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Ctrl+C copies the selection, Ctrl+V pastes tab-separated text."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                    <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon Glyph="&#xE9A6;"
                                  FontSize="16"
                                  VerticalAlignment="Top"
                                  Margin="0,2,0,0"
                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Resize"
                                       Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock Text="Drag the edge of a column header, or double-click it to fit the content."
                                       TextWrapping="Wrap"
                                       Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;tv:TableView ItemsSource="{Binding Items}" ShowRowNumbers="True" />
                </x:String>
            </controls:SamplePresenter.Xaml>
        </controls:SamplePresenter>
    </Grid>
</Page>
