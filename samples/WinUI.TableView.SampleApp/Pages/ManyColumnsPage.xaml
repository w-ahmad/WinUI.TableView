<Page x:Class="WinUI.TableView.SampleApp.Pages.ManyColumnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter Header="Many columns"
                                  Description="Builds a table with hundreds of columns and reports how long adding them took and when the table was first laid out.">
            <controls:SamplePresenter.Example>
                <Border x:Name="tableHost" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            MaxWidth="360">
                    <ComboBox x:Name="columnCounts"
                              Header="Column count"
                              HorizontalAlignment="Stretch"
                              SelectionChanged="OnColumnCountChanged" />

                    <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                            CornerRadius="4"
                            Padding="12">
                        <StackPanel Spacing="4">
                            <TextBlock Text="Timing"
                                       FontWeight="SemiBold" />
                            <TextBlock>
                                <Run Text="Columns added in:" />
                                <Run x:Name="addTimeRun"
                                     Text="-" />
                            </TextBlock>
                            <TextBlock>
                                <Run Text="First layout after:" />
                                <Run x:Name="layoutTimeRun"
                                     Text="-" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:SamplePresenter.Options>

            <controls:SamplePresenter.CSharp>
                <x:String xml:space="preserve">
for (var i = 0; i &lt; 500; i++)
{
    tableView.Columns.Add(new TableViewTextColumn
    {
        Header = $"Field {i}",
        Width = new GridLength(110),
        Binding = new Binding { Path = new PropertyPath("FirstName") }
    });
}
                </x:String>
            </controls:SamplePresenter.CSharp>
        </controls:SamplePresenter>
    </Grid>
</Page>
