<Page x:Class="WinUI.TableView.SampleApp.Pages.SectionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls">

    <Grid>
        <VisualStateManager.VisualStateGroups>
            <VisualStateGroup>
                <VisualState x:Name="Wide">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="641" />
                    </VisualState.StateTriggers>
                </VisualState>
                <VisualState x:Name="Phone">
                    <VisualState.StateTriggers>
                        <AdaptiveTrigger MinWindowWidth="0" />
                    </VisualState.StateTriggers>
                    <VisualState.Setters>
                        <Setter Target="content.Padding" Value="12,8,12,32" />
                        <Setter Target="content.Spacing" Value="16" />
                    </VisualState.Setters>
                </VisualState>
            </VisualStateGroup>
        </VisualStateManager.VisualStateGroups>

    <ScrollViewer>
        <StackPanel x:Name="content"
                    Spacing="24"
                    Padding="32,24,32,48">
            <Grid ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Width="48"
                      Height="48"
                      VerticalAlignment="Top">
                    <Border CornerRadius="10"
                            Opacity="0.14"
                            Background="{ThemeResource AccentFillColorDefaultBrush}" />
                    <FontIcon x:Name="icon"
                              FontSize="22"
                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" />
                </Grid>
                <StackPanel Grid.Column="1"
                            VerticalAlignment="Center">
                    <TextBlock x:Name="title"
                               TextWrapping="Wrap"
                               Style="{StaticResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="description"
                               TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </Grid>

            <controls:SampleTiles x:Name="tiles" />
        </StackPanel>
    </ScrollViewer>
    </Grid>
</Page>
