<Page x:Class="WinUI.TableView.SampleApp.Pages.ClipboardActionsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.TableView.SampleApp"
      xmlns:pages="using:WinUI.TableView.SampleApp.Pages"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      xmlns:helpers="using:WinUI.TableView.SampleApp.Helpers"
      d:DataContext="{d:DesignInstance Type=local:ExampleViewModel}"
      mc:Ignorable="d">

    <Grid>
        <controls:SamplePresenter x:Name="presenter"
                                  Header="Clipboard Actions"
                                  Description="Ctrl+C copies the selected rows or cells as tab-separated text and Ctrl+Shift+C adds the headers; Ctrl+V pastes text from Excel starting at the current cell. The same text is available in code.">
            <controls:SamplePresenter.Example>
                <tv:TableView x:Name="tableView"
                              ItemsSource="{Binding Items}"
                              CanCopy="{x:Bind canCopyToggle.IsOn, Mode=OneWay}"
                              CanPaste="{x:Bind canPasteToggle.IsOn, Mode=OneWay}"
                              CopyToClipboard="OnCopyToClipboard"
                              AutoGeneratingColumn="{x:Bind local:ExampleModelColumnsHelper.OnAutoGeneratingColumns}" />
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            Width="300">
                    <ToggleSwitch x:Name="canCopyToggle"
                                  Header="CanCopy"
                                  IsOn="True"
                                  OnContent="True"
                                  OffContent="False" />
                    <ToggleSwitch x:Name="canPasteToggle"
                                  Header="CanPaste"
                                  IsOn="True"
                                  OnContent="True"
                                  OffContent="False" />
                    <StackPanel Spacing="8">
                        <TextBlock Text="Selection as text"
                                   Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <CheckBox x:Name="includeHeaders"
                                  Content="Include headers"
                                  IsChecked="True" />
                        <Button Content="Read the selection"
                                Click="OnReadSelectionClicked" />
                        <TextBox x:Name="copiedText"
                                 Height="180"
                                 IsReadOnly="True"
                                 AcceptsReturn="True"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 PlaceholderText="Nothing read yet."
                                 ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto" />
                    </StackPanel>
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;tv:TableView x:Name="tableView"
              ItemsSource="{Binding Items}"
              CanCopy="$(CanCopy)"
              CanPaste="$(CanPaste)"
              CopyToClipboard="OnCopyToClipboard" />
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.CSharp>
                <x:String xml:space="preserve">
// Raised by Ctrl+C, Ctrl+Shift+C and the menu. Set e.Handled to put your own content on the clipboard.
private void OnCopyToClipboard(object? sender, TableViewCopyToClipboardEventArgs e)
{
    var text = tableView.GetSelectedContent(e.IncludeHeaders);
}

// The same content on demand, with any separator.
var csv = tableView.GetSelectedContent(includeHeaders: true, separator: ',');
var everything = tableView.GetAllContent(includeHeaders: true);
                </x:String>
            </controls:SamplePresenter.CSharp>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="CanCopy"
                                           Value="{x:Bind canCopyToggle.IsOn, Mode=OneWay}" />
                <controls:CodeSubstitution Key="CanPaste"
                                           Value="{x:Bind canPasteToggle.IsOn, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>
