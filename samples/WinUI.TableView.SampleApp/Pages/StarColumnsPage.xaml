<Page x:Class="WinUI.TableView.SampleApp.Pages.StarColumnsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:WinUI.TableView.SampleApp"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:helpers="using:WinUI.TableView.SampleApp.Helpers"
      d:DataContext="{d:DesignInstance Type=local:ExampleViewModel}"
      mc:Ignorable="d"
      DataContextChanged="OnDataContextChanged">

    <Grid>
        <controls:SamplePresenter Header="Star Columns"
                                  Description="Columns with a star (*) width share the space left by the other columns and fill the table up to its right edge.">
            <controls:SamplePresenter.Example>
                <tv:TableView x:Name="tableView"
                              Width="{x:Bind tableWidth.Value, Mode=OneWay}"
                              HorizontalAlignment="Left"
                              AutoGenerateColumns="False"
                              HeadersVisibility="None"
                              GridLinesVisibility="All"
                              ItemsSource="{Binding Items}">
                    <tv:TableView.Columns>
                        <tv:TableViewTextColumn Header="First Name"
                                                Binding="{Binding FirstName}" />
                        <tv:TableViewTextColumn Header="Email"
                                                Width="2*"
                                                Binding="{Binding Email}" />
                        <tv:TableViewTextColumn Header="Department"
                                                Width="*"
                                                Binding="{Binding Department}">
                            <tv:TableViewTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="HorizontalAlignment"
                                            Value="Right" />
                                    <Setter Property="TextTrimming"
                                            Value="CharacterEllipsis" />
                                </Style>
                            </tv:TableViewTextColumn.ElementStyle>
                        </tv:TableViewTextColumn>
                    </tv:TableView.Columns>
                </tv:TableView>
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            MinWidth="200">
                    <Slider x:Name="tableWidth"
                            Header="Table Width"
                            Minimum="300"
                            Maximum="900"
                            Value="500" />
                    <ComboBox x:Name="headersVisibility"
                              HorizontalAlignment="Stretch"
                              Header="Headers Visibility"
                              SelectedItem="{Binding HeadersVisibility, Mode=TwoWay, ElementName=tableView}"
                              ItemsSource="{helpers:EnumValues Type=tv:TableViewHeadersVisibility}" />
                    <ComboBox x:Name="gridLinesVisibility"
                              HorizontalAlignment="Stretch"
                              Header="Grid Lines Visibility"
                              SelectedItem="{Binding GridLinesVisibility, Mode=TwoWay, ElementName=tableView}"
                              ItemsSource="{helpers:EnumValues Type=tv:TableViewGridLinesVisibility}" />
                    <ComboBox x:Name="selectionMode"
                              HorizontalAlignment="Stretch"
                              Header="Selection Mode"
                              SelectedItem="{x:Bind tableView.SelectionMode, Mode=OneWay, Converter={StaticResource EnumToString}}"
                              SelectionChanged="OnSelectionModeChanged" />
                    <TextBlock Text="Select a row: the selection should end exactly where the last cell ends."
                               TextWrapping="Wrap"
                               Opacity="0.7" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;tv:TableView Width="$(Width)"
    AutoGenerateColumns="False"
    HeadersVisibility="$(HeadersVisibility)"
    GridLinesVisibility="$(GridLinesVisibility)"
    SelectionMode="$(SelectionMode)"
    ItemsSource="{Binding Items}">
    &lt;tv:TableView.Columns>
        &lt;tv:TableViewTextColumn Header="First Name" Binding="{Binding FirstName}" />
        &lt;tv:TableViewTextColumn Header="Email" Width="2*" Binding="{Binding Email}" />
        &lt;tv:TableViewTextColumn Header="Department" Width="*" Binding="{Binding Department}">
            &lt;tv:TableViewTextColumn.ElementStyle>
                &lt;Style TargetType="TextBlock">
                    &lt;Setter Property="HorizontalAlignment" Value="Right" />
                    &lt;Setter Property="TextTrimming" Value="CharacterEllipsis" />
                &lt;/Style>
            &lt;/tv:TableViewTextColumn.ElementStyle>
        &lt;/tv:TableViewTextColumn>
    &lt;/tv:TableView.Columns>
&lt;/tv:TableView>
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="Width"
                                           Value="{x:Bind tableWidth.Value, Mode=OneWay}" />
                <controls:CodeSubstitution Key="HeadersVisibility"
                                           Value="{x:Bind tableView.HeadersVisibility, Mode=OneWay}" />
                <controls:CodeSubstitution Key="GridLinesVisibility"
                                           Value="{x:Bind tableView.GridLinesVisibility, Mode=OneWay}" />
                <controls:CodeSubstitution Key="SelectionMode"
                                           Value="{x:Bind tableView.SelectionMode, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>
