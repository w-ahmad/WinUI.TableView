<Page x:Class="WinUI.TableView.SampleApp.Pages.RowDetailsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.TableView.SampleApp"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      xmlns:ui="using:CommunityToolkit.WinUI"
      d:DataContext="{d:DesignInstance Type=local:ExampleViewModel}"
      mc:Ignorable="d"
      DataContextChanged="OnDataContextChanged">

    <Grid>
        <controls:SamplePresenter Header="Row Details"
                                  Description="Showcasing an expandable details panel below each row that can display additional information about that row's item.">
            <controls:SamplePresenter.Example>
                <tv:TableView x:Name="tableView"
                              ItemsSource="{Binding Items}"
                              RowDetailsVisibilityMode="VisibleWhenExpanded"
                              AutoGeneratingColumn="{x:Bind local:ExampleModelColumnsHelper.OnAutoGeneratingColumns}">
                    <tv:TableView.RowDetailsTemplate>
                        <DataTemplate x:DataType="local:ExampleModel">
                            <Grid Padding="16"
                                  ColumnSpacing="16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Width="64"
                                        Height="64"
                                        CornerRadius="32"
                                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                    <Image Source="{x:Bind Avatar}"
                                           Stretch="UniformToFill" />
                                </Border>

                                <StackPanel Grid.Column="1"
                                            Spacing="4"
                                            VerticalAlignment="Center">
                                    <TextBlock FontSize="16"
                                               FontWeight="SemiBold">
                                        <Run Text="{x:Bind FirstName}" />
                                        <Run Text="{x:Bind LastName}" />
                                    </TextBlock>
                                    <TextBlock Text="{x:Bind Email}"
                                               Opacity="0.7" />
                                    <TextBlock Text="{x:Bind Address}"
                                               Opacity="0.7"
                                               TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal"
                                                Spacing="8"
                                                Margin="0,4,0,0">
                                        <Border Padding="8,2"
                                                CornerRadius="10"
                                                Visibility="{x:Bind IsActive}"
                                                Background="{ThemeResource SystemFillColorSuccessBackgroundBrush}">
                                            <TextBlock Text="Active"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                        <TextBlock FontSize="12"
                                                   VerticalAlignment="Center">
                                            <Run Text="{x:Bind Department}" />
                                            <Run Text="•" Foreground="{ThemeResource TextFillColorDisabledBrush}" />
                                            <Run Text="{x:Bind Designation}" />
                                        </TextBlock>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </tv:TableView.RowDetailsTemplate>
                </tv:TableView>
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            MinWidth="200">
                    <ComboBox x:Name="rowDetailsVisibilityMode"
                              Header="Row Details Visibility Mode"
                              HorizontalAlignment="Stretch"
                              SelectedItem="{Binding RowDetailsVisibilityMode, Mode=TwoWay, ElementName=tableView}"
                              ItemsSource="{ui:EnumValues Type=tv:TableViewRowDetailsVisibilityMode}" />
                    <ToggleSwitch x:Name="areRowDetailsFrozen"
                                  Header="Freeze Row Details"
                                  IsOn="{Binding AreRowDetailsFrozen, Mode=TwoWay, ElementName=tableView}" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;tv:TableView x:Name="tableView"
    ItemsSource="{Binding Items}"
    RowDetailsVisibilityMode="$(RowDetailsVisibilityMode)"
    AreRowDetailsFrozen="$(AreRowDetailsFrozen)">
    &lt;tv:TableView.RowDetailsTemplate>
        &lt;DataTemplate x:DataType="local:ExampleModel">
            &lt;Grid Padding="16" ColumnSpacing="16">
                &lt;Grid.ColumnDefinitions>
                    &lt;ColumnDefinition Width="Auto" />
                    &lt;ColumnDefinition Width="*" />
                &lt;/Grid.ColumnDefinitions>
                &lt;Border Width="64" Height="64" CornerRadius="32"
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                    &lt;Image Source="{x:Bind Avatar}" Stretch="UniformToFill" />
                &lt;/Border>
                &lt;StackPanel Grid.Column="1" Spacing="4">
                    &lt;TextBlock FontSize="16" FontWeight="SemiBold">
                        &lt;Run Text="{x:Bind FirstName}" />
                        &lt;Run Text="{x:Bind LastName}" />
                    &lt;/TextBlock>
                    &lt;TextBlock Text="{x:Bind Email}" Opacity="0.7" />
                    &lt;TextBlock Text="{x:Bind Address}" Opacity="0.7" TextWrapping="Wrap" />
                &lt;/StackPanel>
            &lt;/Grid>
        &lt;/DataTemplate>
    &lt;/tv:TableView.RowDetailsTemplate>
&lt;/tv:TableView>
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="RowDetailsVisibilityMode"
                                           Value="{x:Bind tableView.RowDetailsVisibilityMode, Mode=OneWay}" />
                <controls:CodeSubstitution Key="AreRowDetailsFrozen"
                                           Value="{x:Bind tableView.AreRowDetailsFrozen, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>
