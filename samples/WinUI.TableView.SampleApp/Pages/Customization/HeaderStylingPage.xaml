<Page x:Class="WinUI.TableView.SampleApp.Pages.HeaderStylingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:WinUI.TableView.SampleApp"
      xmlns:pages="using:WinUI.TableView.SampleApp.Pages"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:tv="using:WinUI.TableView"
      xmlns:controls="using:WinUI.TableView.SampleApp.Controls"
      xmlns:helpers="using:WinUI.TableView.SampleApp.Helpers"
      d:DataContext="{d:DesignInstance Type=local:ExampleViewModel}"
      mc:Ignorable="d"
      DataContextChanged="OnDataContextChanged">

    <Page.Resources>
        <!--  Every header of the table  -->
        <Style x:Key="HeaderStyle"
               TargetType="tv:TableViewColumnHeader">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="CharacterSpacing" Value="80" />
            <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
        </Style>

        <!--  A column's HeaderStyle replaces the table's, so build on it  -->
        <Style x:Key="NumberHeaderStyle"
               TargetType="tv:TableViewColumnHeader"
               BasedOn="{StaticResource HeaderStyle}">
            <Setter Property="HorizontalContentAlignment" Value="Right" />
        </Style>

        <Style x:Key="AccentHeaderStyle"
               TargetType="tv:TableViewColumnHeader"
               BasedOn="{StaticResource HeaderStyle}">
            <Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <Grid>
        <controls:SamplePresenter x:Name="presenter"
                                  Header="Header Styling"
                                  Description="ColumnHeaderStyle restyles every header, a column&apos;s HeaderStyle restyles one, and Header takes any content, not only text.">
            <controls:SamplePresenter.Example>
                <tv:TableView x:Name="tableView"
                              ItemsSource="{Binding Items}"
                              AutoGenerateColumns="False"
                              HeaderRowHeight="44"
                              ColumnHeaderStyle="{StaticResource HeaderStyle}">
                    <tv:TableView.Columns>
                        <tv:TableViewNumberColumn Header="ID"
                                                  Width="90"
                                                  Binding="{Binding Id}"
                                                  HeaderStyle="{StaticResource NumberHeaderStyle}" />

                        <!--  Header is an object: put an icon next to the text  -->
                        <tv:TableViewTextColumn Width="200"
                                                IsReadOnly="True"
                                                Binding="{Binding FullName}">
                            <tv:TableViewTextColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE77B;"
                                              FontSize="14" />
                                    <TextBlock Text="EMPLOYEE" />
                                </StackPanel>
                            </tv:TableViewTextColumn.Header>
                        </tv:TableViewTextColumn>

                        <tv:TableViewTextColumn Width="280"
                                                Binding="{Binding Email}">
                            <tv:TableViewTextColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE715;"
                                              FontSize="14" />
                                    <TextBlock Text="EMAIL" />
                                </StackPanel>
                            </tv:TableViewTextColumn.Header>
                        </tv:TableViewTextColumn>

                        <tv:TableViewTextColumn Header="DEPARTMENT"
                                                Width="180"
                                                Binding="{Binding Department}"
                                                HeaderStyle="{StaticResource AccentHeaderStyle}" />

                        <tv:TableViewDateColumn Width="160"
                                                Binding="{Binding Dob}">
                            <tv:TableViewDateColumn.Header>
                                <StackPanel Orientation="Horizontal"
                                            Spacing="8">
                                    <FontIcon Glyph="&#xE787;"
                                              FontSize="14" />
                                    <TextBlock Text="BIRTHDAY" />
                                </StackPanel>
                            </tv:TableViewDateColumn.Header>
                        </tv:TableViewDateColumn>
                    </tv:TableView.Columns>
                </tv:TableView>
            </controls:SamplePresenter.Example>
            <controls:SamplePresenter.Options>
                <StackPanel Spacing="16"
                            MinWidth="220">
                    <NumberBox Header="HeaderRowHeight"
                               Minimum="32"
                               Maximum="80"
                               SmallChange="4"
                               SpinButtonPlacementMode="Inline"
                               Value="{Binding HeaderRowHeight, Mode=TwoWay, ElementName=tableView}" />
                    <ComboBox Header="HeaderGridLinesVisibility"
                              HorizontalAlignment="Stretch"
                              SelectedItem="{Binding HeaderGridLinesVisibility, Mode=TwoWay, ElementName=tableView}"
                              ItemsSource="{helpers:EnumValues Type=tv:TableViewGridLinesVisibility}" />
                </StackPanel>
            </controls:SamplePresenter.Options>
            <controls:SamplePresenter.Xaml>
                <x:String xml:space="preserve">
&lt;Page.Resources>
    &lt;!--  Every header of the table  -->
    &lt;Style x:Key="HeaderStyle" TargetType="tv:TableViewColumnHeader">
        &lt;Setter Property="FontSize" Value="12" />
        &lt;Setter Property="FontWeight" Value="Bold" />
        &lt;Setter Property="CharacterSpacing" Value="80" />
        &lt;Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
    &lt;/Style>

    &lt;!--  A column's HeaderStyle replaces the table's, so build on it  -->
    &lt;Style x:Key="NumberHeaderStyle" TargetType="tv:TableViewColumnHeader"
           BasedOn="{StaticResource HeaderStyle}">
        &lt;Setter Property="HorizontalContentAlignment" Value="Right" />
    &lt;/Style>

    &lt;Style x:Key="AccentHeaderStyle" TargetType="tv:TableViewColumnHeader"
           BasedOn="{StaticResource HeaderStyle}">
        &lt;Setter Property="Background" Value="{ThemeResource AccentFillColorDefaultBrush}" />
        &lt;Setter Property="Foreground" Value="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
    &lt;/Style>
&lt;/Page.Resources>

&lt;tv:TableView ItemsSource="{Binding Items}"
              AutoGenerateColumns="False"
              HeaderRowHeight="$(HeaderRowHeight)"
              HeaderGridLinesVisibility="$(HeaderGridLinesVisibility)"
              ColumnHeaderStyle="{StaticResource HeaderStyle}">
    &lt;tv:TableView.Columns>
        &lt;tv:TableViewNumberColumn Header="ID"
                                  Binding="{Binding Id}"
                                  HeaderStyle="{StaticResource NumberHeaderStyle}" />

        &lt;!--  Header is an object: put an icon next to the text  -->
        &lt;tv:TableViewTextColumn Binding="{Binding FullName}" IsReadOnly="True">
            &lt;tv:TableViewTextColumn.Header>
                &lt;StackPanel Orientation="Horizontal" Spacing="8">
                    &lt;FontIcon Glyph="&amp;#xE77B;" FontSize="14" />
                    &lt;TextBlock Text="EMPLOYEE" />
                &lt;/StackPanel>
            &lt;/tv:TableViewTextColumn.Header>
        &lt;/tv:TableViewTextColumn>

        &lt;tv:TableViewTextColumn Header="DEPARTMENT"
                                Binding="{Binding Department}"
                                HeaderStyle="{StaticResource AccentHeaderStyle}" />
    &lt;/tv:TableView.Columns>
&lt;/tv:TableView>
                </x:String>
            </controls:SamplePresenter.Xaml>
            <controls:SamplePresenter.Substitutions>
                <controls:CodeSubstitution Key="HeaderRowHeight"
                                           Value="{x:Bind tableView.HeaderRowHeight, Mode=OneWay}" />
                <controls:CodeSubstitution Key="HeaderGridLinesVisibility"
                                           Value="{x:Bind tableView.HeaderGridLinesVisibility, Mode=OneWay}" />
            </controls:SamplePresenter.Substitutions>
        </controls:SamplePresenter>
    </Grid>
</Page>
